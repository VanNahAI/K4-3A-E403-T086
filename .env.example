# Mã bí mật bắt buộc để cấp quyền điều phối phiên cho giảng viên.
# Tạo một giá trị ngẫu nhiên dài trước khi chạy production.
LECTURER_ACCESS_TOKEN=thay-bang-chuoi-bi-mat-ngau-nhien

# Cổng HTTP/WS của server.
PORT=3000

# Giới hạn request body để tránh upload làm quá tải server (mặc định 1 MB).
MAX_REQUEST_BODY_BYTES=1048576

# Cấu hình Zoom thật (bắt buộc khi triển khai).
ZOOM_MEETING_URL=https://us06web.zoom.us/j/your-meeting-id
ZOOM_MEETING_ID=your-meeting-id
ZOOM_PASSCODE=your-passcode
ZOOM_TOPIC=AI20K Workshop
ZOOM_SPEAKER=Ten giang vien

# Secret token lấy từ Zoom Marketplace Webhook của app Zoom.
ZOOM_WEBHOOK_SECRET_TOKEN=thay-bang-webhook-secret-token

# OAuth credentials của General App (không đưa các giá trị này lên GitHub).
ZOOM_OAUTH_CLIENT_ID=thay-bang-client-id
ZOOM_OAUTH_CLIENT_SECRET=thay-bang-client-secret
# Phải khớp tuyệt đối với OAuth Redirect URL trong Zoom Developer.
ZOOM_OAUTH_REDIRECT_URI=https://your-domain.example/api/zoom/oauth/callback
ZOOM_OAUTH_SUCCESS_PATH=/zoom-auth-success

# Chỉ bật khi cần chạy lại phòng Zoom mô phỏng cho test legacy.
ENABLE_SIMULATION=false
